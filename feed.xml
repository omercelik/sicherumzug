---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <author>
    <name>Sicher Team</name>
    <email>office@sicher-umzug.at</email>
  </author>
  {% for post in site.pages limit:10 %}
    {% if post.title %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <link href="{{ site.url }}{{ site.baseurl }}{{ post.url }}"/>
      <updated>{{ post.date | default: site.time | date_to_xmlschema }}</updated>
      <id>{{ site.url }}{{ site.baseurl }}{{ post.url }}</id>
      <content type="html">{{ post.content | xml_escape }}</content>
    </entry>
    {% endif %}
  {% endfor %}
</feed>
